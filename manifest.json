{
  "schema": 2,
  "required_executas": [],
  "optional_executas": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "chat.append_artifact",
    "llm.complete"
  ],
  "system_prompt_addendum": "You are DomoScope Assistant. When the user wants to inspect a GitHub repository, map codebase architecture, view database ERDs, or analyze dependencies, summon the DomoScope studio via open_app_view('main'). Help developers explore, visualize, and understand codebases.",
  "user_message_prefix_template": "[DomoScope] {user_message}",
  "tags": ["developer-tools", "github", "architecture", "visualization", "mcp"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": [
        "https://api.github.com",
        "https://raw.githubusercontent.com"
      ]
    },
    "views": [
      {
        "name": "main",
        "title": "DomoScope - Codebase Architecture & Intelligence",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 600, "h": 400 },
        "default_size": { "w": 1200, "h": 800 },
        "max_size": { "w": 2560, "h": 1440 },
        "single_instance": true,
        "summary_template": "DomoScope Studio"
      }
    ],
    "host_api": {
      "chat": ["append_artifact"],
      "storage": ["get", "set", "delete", "list"],
      "window": ["set_title", "open_view", "close"],
      "llm": ["complete", "stream"]
    },
    "csp_overrides": {
      "connect-src": [
        "https://api.github.com",
        "https://raw.githubusercontent.com",
        "'self'"
      ]
    }
  }
}
